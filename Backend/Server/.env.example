PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret

# ---------------------------------------------------------------------------
# AI providers, tried in the order listed in AI_PROVIDERS.
# Whichever answers first wins. A provider is skipped silently when its key is
# missing, and the next one is tried on 402/429/5xx/timeout. A 401/403 stops the
# chain immediately, because retrying elsewhere would only mask a bad key.
# ---------------------------------------------------------------------------

# Groq: free, no credit card, ~1000 requests/day and 200k tokens/day per model.
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter: paid by default, but many `:free` models are available.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
# Free alternatives that work for this project:
#   nvidia/nemotron-3-super-120b-a12b:free
#   qwen/qwen3.8-27b:free
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# Comma-separated provider order. Providers without a key are skipped.
AI_PROVIDERS=groq,openrouter

# Request timeout for AI calls in milliseconds
AI_TIMEOUT_MS=60000

# Allowed frontend origin for CORS (optional, *.vercel.app is always allowed)
CLIENT_URL=http://localhost:5173